POSTGRES_DB=saas_catalog
POSTGRES_USER=saas
POSTGRES_PASSWORD=change-me-locally
ConnectionStrings__Catalog=Host=localhost;Port=5432;Database=saas_catalog;Username=saas;Password=change-me-locally
Authentication__Authority=http://localhost:8080
Authentication__Audience=saas-api
Authentication__SigningCertificatePath=/run/secrets/saas-signing.pfx
Authentication__SigningCertificatePassword=use-a-secret-manager
Cors__AllowedOrigins=http://localhost:3000
Seed__Enabled=false
Seed__DemoPassword=use-dotnet-user-secrets
Database__ApplyMigrations=false
Database__AllowProductionMigrations=false
